# .env de PRODUCCIÓN — plantilla (NO pegar valores reales aquí).
# En prod, estas variables las inyecta el pipeline (GitHub Actions → VPS) como
# secretos del entorno, NUNCA versionadas. Este archivo solo documenta cuáles son.
# El archivo real (.env.production / variables del servicio) queda fuera de git.

# ── OBLIGATORIAS ────────────────────────────────────────────────────────────

# Postgres del control-plane (auth, tenants, config cifrada, runs). RLS FORZADA.
# El usuario de conexión NO debe ser superusuario (un superusuario IGNORA la RLS
# y rompe el aislamiento por tenant; el propio kit lo marca como hallazgo).
CONTROL_PLANE_URL=postgres://USUARIO:CLAVE@HOST:5432/BASE?sslmode=require

# Llave maestra de cifrado AES-256-GCM (32 bytes en hex/base64). Cifra los
# secretos de cada tenant (PAT de ADO, claves de BD/SSH de regresión).
# ⚠ Si cambia, TODO lo cifrado con la anterior queda ilegible → planear rotación
#   (re-cifrar) antes de cambiarla. Guardar SOLO en el gestor de secretos.
QA_KIT_MASTER_KEY=

# Entorno de ejecución.
NODE_ENV=production

# ── OPCIONALES ──────────────────────────────────────────────────────────────

# Token de GitHub para leer PRs privados en el modo "Analizar PR" (la API pública
# funciona sin token; solo hace falta para repos privados o rate-limit alto).
# GITHUB_TOKEN=

# Socket del agente SSH, si algún tenant tunneliza a su BD por SSH con agente.
# SSH_AUTH_SOCK=
