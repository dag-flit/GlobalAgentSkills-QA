# Copiar a .env.user-identity (el archivo real NO se versiona).
# Nunca pegues un PAT real en este .example.
#
# Trazabilidad en Features/Tasks (comentario Discussion):
#   "Work item registrado por el agente de QA bajo supervisión de
#    {USER_REAL_NAME} ({USER_REAL_EMAIL})."
# Ver regla: .cursor/rules/ado-qa-trazabilidad.mdc

USER_REAL_NAME=Tu Nombre Completo
USER_REAL_EMAIL=tu.correo@flitsas.com.co
AZURE_ORG_URL=https://dev.azure.com/FlitDevOps
AZURE_PROJECT_NAME=FLIT - EVOLUTION

# Opcional — solo fallback si MCP user-ado no está disponible
# Scopes mínimos: Work Items (Read & Write)
# AZURE_PAT=
